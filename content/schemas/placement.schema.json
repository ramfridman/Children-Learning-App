{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nitznutz:schema:placement",
  "title": "Nitznutz placement",
  "type": "object",
  "properties": {
    "schema": {
      "const": "placement/v1"
    },
    "id": {
      "type": "string",
      "minLength": 13,
      "maxLength": 13,
      "pattern": "^(?:[a-z]{3}\\.placement)$"
    },
    "review": {
      "type": "string",
      "enum": [
        "needs-editor",
        "approved"
      ]
    },
    "course": {
      "type": "string",
      "enum": [
        "core",
        "eng",
        "heb",
        "rus"
      ]
    },
    "thanks": {
      "type": "object",
      "properties": {
        "vo": {
          "type": "string",
          "minLength": 4,
          "maxLength": 83,
          "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
        },
        "caption": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "const": "he"
              },
              "v": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "t",
              "v"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1
        },
        "target": {
          "type": "string",
          "minLength": 4,
          "maxLength": 83,
          "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
        },
        "target2": {
          "type": "string",
          "minLength": 4,
          "maxLength": 83,
          "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
        },
        "show": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "vo",
        "caption"
      ],
      "additionalProperties": false
    },
    "celebration": {
      "type": "object",
      "properties": {
        "vo": {
          "type": "string",
          "minLength": 4,
          "maxLength": 83,
          "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
        },
        "caption": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "const": "he"
              },
              "v": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "t",
              "v"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1
        },
        "target": {
          "type": "string",
          "minLength": 4,
          "maxLength": 83,
          "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
        },
        "target2": {
          "type": "string",
          "minLength": 4,
          "maxLength": 83,
          "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
        },
        "show": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "vo",
        "caption"
      ],
      "additionalProperties": false
    },
    "perVisit": {
      "type": "integer",
      "minimum": 4,
      "maximum": 10
    },
    "strands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4,
            "pattern": "^(?:[a-z0-9]{1,4})$"
          },
          "offer": {
            "type": "object",
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 2,
                "maxLength": 24,
                "pattern": "^(?:[a-z][A-Za-z0-9]{1,23})$"
              },
              "equals": {
                "type": "string",
                "minLength": 2,
                "maxLength": 24,
                "pattern": "^(?:[a-z][A-Za-z0-9]{1,23})$"
              },
              "minBand": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "start": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 24,
                  "pattern": "^(?:[a-z][A-Za-z0-9]{1,23})$"
                },
                "equals": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 24,
                  "pattern": "^(?:[a-z][A-Za-z0-9]{1,23})$"
                },
                "level": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                }
              },
              "required": [
                "answer",
                "equals",
                "level"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 8
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 81,
                    "pattern": "^(?:[a-z0-9][a-z0-9._-]{2,80})$"
                  },
                  "minItems": 1,
                  "maxItems": 6
                },
                "assumes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 14,
                    "pattern": "^(?:[A-Z]{2,5}-[ABC]-\\d{2}(?:\\.[A-Z][0-9]{1,2})?)$"
                  },
                  "minItems": 0,
                  "maxItems": 20
                }
              },
              "required": [
                "items"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 8
          }
        },
        "required": [
          "id",
          "levels"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
    }
  },
  "required": [
    "schema",
    "id",
    "thanks",
    "celebration",
    "perVisit",
    "strands"
  ],
  "additionalProperties": false
}
