{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nitznutz:schema:pack-source",
  "title": "Nitznutz pack-source",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pack-source/v1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 41,
      "pattern": "^(?:[a-z0-9][a-z0-9-]{2,40})$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 11,
      "pattern": "^(?:\\d{1,3}\\.\\d{1,3}\\.\\d{1,3})$"
    },
    "minAppVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 11,
      "pattern": "^(?:\\d{1,3}\\.\\d{1,3}\\.\\d{1,3})$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^(?:[a-z0-9_]{1,40})$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 101,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,100})$"
          }
        },
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "vo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?:[a-z0-9_.]{1,80})$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 101,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,100})$"
          }
        },
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4000
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "minAppVersion",
    "assets",
    "vo"
  ],
  "additionalProperties": false
}
