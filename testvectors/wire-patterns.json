    "pack_id": { "pattern": "^[a-z0-9-]{3,41}$", "max": 41 },
    "pack_version": { "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$", "max": 14 },
    "lesson_id": { "pattern": "^[a-z0-9._-]{0,40}$", "max": 40 },
    "template": { "pattern": "^[a-z_]{2,30}$", "max": 30 },
    "template_version": { "pattern": "^[0-9.]{1,10}$", "max": 10 },
    "skill_id": { "pattern": "^[A-Z]{2,5}-[A-C]-[0-9]{2}$", "max": 11 },
    "misconception_tag": { "pattern": "^(M-[A-Z]{2,5}-[A-Z0-9]{2,12})?$", "max": 20 },
    "response": { "pattern": "^[A-Za-z0-9=._-]{0,40}$", "max": 40 }
  },
  "tutor_option": "^[a-z0-9=-]{1,16}$",
