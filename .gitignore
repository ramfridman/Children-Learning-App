**/ios/Flutter/ephemeral/
DerivedData/
*.iml
*.ipa
*.apk
*.aab
*.dSYM.zip

# ---- Node / Deno / Supabase local state ----
node_modules/
supabase/.temp/
supabase/.branches/
.deno/

# ---- Generated audio (large files stay out of Git; packs are built and published by tools) ----
tools/voice_gen/output/
*.wav
*.flac

# ---- Editors and OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Golden comparison output
app/test/failures/

# ---- Firebase client files: hold a Google API key, kept in 1Password and copied in by hand ----
app/android/app/src/*/google-services.json
