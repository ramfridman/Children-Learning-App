{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nitznutz:schema:manifest",
  "title": "Nitznutz manifest",
  "type": "object",
  "properties": {
    "schema": {
      "const": "manifest/v1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 41,
      "pattern": "^(?:[a-z0-9][a-z0-9-]{2,40})$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 11,
      "pattern": "^(?:\\d{1,3}\\.\\d{1,3}\\.\\d{1,3})$"
    },
    "minAppVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 11,
      "pattern": "^(?:\\d{1,3}\\.\\d{1,3}\\.\\d{1,3})$"
    },
    "templates": {
      "type": "object",
      "properties": {
        "tap_answer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 5,
          "pattern": "^(?:\\d{1,2}\\.\\d{1,2})$"
        },
        "count_tap": {
          "type": "string",
          "minLength": 3,
          "maxLength": 5,
          "pattern": "^(?:\\d{1,2}\\.\\d{1,2})$"
        },
        "give_n": {
          "type": "string",
          "minLength": 3,
          "maxLength": 5,
          "pattern": "^(?:\\d{1,2}\\.\\d{1,2})$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 101,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,100})$"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^(?:[0-9a-f]{64})$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          }
        },
        "required": [
          "name",
          "sha256",
          "size"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 400
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^(?:[a-z0-9_]{1,40})$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 101,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,100})$"
          }
        },
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 400
    },
    "vo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?:[a-z0-9_.]{1,80})$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 101,
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,100})$"
          }
        },
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 400
    },
    "voPending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 83,
        "pattern": "^(?:vo:[a-z0-9_.]{1,80})$"
      },
      "minItems": 0,
      "maxItems": 400
    },
    "entries": {
      "type": "object",
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 81,
            "pattern": "^(?:[a-z0-9][a-z0-9._-]{2,80})$"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "lessons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 81,
            "pattern": "^(?:[a-z0-9][a-z0-9._-]{2,80})$"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 6,
            "maxLength": 11,
            "pattern": "^(?:[A-Z]{2,5}-[ABC]-\\d{2})$"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20,
            "pattern": "^(?:M-[A-Z]{2,5}-[A-Z0-9]{2,12})$"
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "activities",
        "lessons",
        "skills",
        "misconceptions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "minAppVersion",
    "templates",
    "files",
    "assets",
    "vo",
    "voPending",
    "entries"
  ],
  "additionalProperties": false
}
