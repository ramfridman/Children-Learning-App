# Copy to .env on YOUR computer only. .env is ignored by Git and scanned for by gitleaks.
# This file lists names only. Never put a real value in this file.
# Server-side secrets (Anthropic, ElevenLabs runtime key, Supabase secret key, database URL)
# do NOT belong in .env: they are set with `npx supabase secrets set` and live only in Supabase.

# Used by tools/voice_gen on your computer only (rotate after each generation run).
ELEVENLABS_GENERATION_KEY=

# Used by tools/pack_builder / content-publish from your computer only.
CONTENT_PUBLISH_SECRET=

# Local Supabase stack (public defaults from `supabase start`, filled in locally).
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
