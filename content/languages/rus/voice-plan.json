  "frameLines": [
    {
      "id": "f01",
      "vo": "vo:rus.f01",
      "he": "הַקְשִׁיבוּ, וּגְעוּ בַּתְּמוּנָה.",
      "voice": "הקשיבו, וגעו בתמונה.",
      "review": "text-ready"
    },
    {
      "id": "f02",
      "vo": "vo:rus.f02",
      "he": "הַקְשִׁיבוּ שׁוּב.",
      "voice": "הקשיבו שוב.",
      "review": "text-ready"
    },
    {
      "id": "f03",
      "vo": "vo:rus.f03",
      "he": "בּוֹאוּ נֹאמַר יַחַד.",
      "voice": "בואו נגיד יחד.",
      "review": "text-ready"
    },
    {
      "id": "f04",
      "vo": "vo:rus.f04",
      "he": "שָׁמַעְתִּי:",
      "voice": "שמעתי:",
      "review": "text-ready"
    },
    {
      "id": "f06",
      "vo": "vo:rus.f06",
      "he": "מַה זֶּה? נַסּוּ לְהַגִּיד בְּרוּסִית.",
      "voice": "מה זה? נסו להגיד ברוסית.",
      "review": "text-ready"
    },
    {
      "id": "f07",
      "vo": "vo:rus.f07",
      "he": "מָה עוֹנִים לֶחָבֵר?",
      "voice": "מה עונים לֶחָבֵר?",
      "review": "text-ready"
    },
    {
      "id": "f08",
      "vo": "vo:rus.f08",
      "he": "הַקְשִׁיבוּ, וּמִצְאוּ אֶת זֶה אֵצֶל הֶחָבֵר.",
      "voice": "הקשיבו, ומצאו את זה אצל החבר.",
      "review": "text-ready"
    },
    {
      "id": "f09",
      "vo": "vo:rus.f09",
      "he": "הַקְשִׁיבוּ, וְעִזְרוּ לֶחָבֵר לַעֲשׂוֹת אֶת זֶה.",
      "voice": "הקשיבו, ועזרו לֶחָבֵר לַעֲשׂוֹת את זה.",
      "review": "text-ready"
    },
    {
      "id": "f10",
      "vo": "vo:rus.f10",
      "he": "עַכְשָׁו אַתֶּם! עֲשׂוּ אֶת זֶה, וְאָז גְּעוּ בַּכַּפְתּוֹר.",
      "voice": "עכשיו אתם, עֲשׂוּ את זה, ואז געו בכפתור.",
      "review": "text-ready"
    },
    {
      "id": "f11",
      "vo": "vo:rus.f11",
      "he": "הַקְשִׁיבוּ, וְשִׂימוּ אֶת זֶה בַּצַּלַּחַת שֶׁל הֶחָבֵר.",
      "voice": "הקשיבו, וְשִׂימוּ את זה בצלחת של החבר.",
      "review": "text-ready"
    },
    {
      "id": "f12",
      "vo": "vo:rus.f12",
      "he": "הַקְשִׁיבוּ, וְשִׂימוּ אֶת זֶה בַּקֻּפְסָה.",
      "voice": "הקשיבו, וְשִׂימוּ את זה בקופסה.",
      "review": "text-ready"
    },
    {
      "id": "f13",
      "vo": "vo:rus.f13",
      "he": "הַקְשִׁיבוּ, וְהַלְבִּישׁוּ אֶת הֶחָבֵר.",
      "voice": "הקשיבו, והלבישו את החבר.",
      "review": "text-ready"
    },
    {
      "id": "f14",
      "vo": "vo:rus.f14",
      "he": "הַקְשִׁיבוּ, וּגְעוּ בַּצֶּבַע.",
      "voice": "הקשיבו, וגעו בצבע.",
      "review": "text-ready"
    },
    {
      "id": "f15",
      "vo": "vo:rus.f15",
      "he": "בּוֹאוּ נִסְפֹּר יַחַד.",
      "voice": "בואו נספור יחד.",
      "review": "text-ready"
    },
    {
      "id": "f16",
      "vo": "vo:rus.f16",
      "he": "הַקְשִׁיבוּ לַמִּסְפָּר, וּגְעוּ בַּתְּמוּנָה.",
      "voice": "הקשיבו למספר, וגעו בתמונה.",
      "review": "text-ready"
    },
    {
      "id": "f17",
      "vo": "vo:rus.f17",
      "he": "הַקְשִׁיבוּ לַשְּׁאֵלָה, וּגְעוּ בַּתְּשׁוּבָה.",
      "voice": "הקשיבו לשאלה, וגעו בתשובה.",
      "review": "text-ready"
    },
    {
      "id": "f18",
      "vo": "vo:rus.f18",
      "he": "זֶה נָכוֹן?",
      "voice": "זה נכון?",
      "review": "text-ready"
    },
    {
      "id": "f20",
      "vo": "vo:rus.f20",
      "he": "הַקְשִׁיבוּ לַבַּקָּשָׁה, וּתְנוּ לֶחָבֵר אֶת מַה שֶּׁמְּבַקְשִׁים.",
      "voice": "הקשיבו לבקשה, ותנו לֶחָבֵר את מה שמבקשים.",
      "review": "text-ready"
    },
    {
      "id": "f21",
      "vo": "vo:rus.f21",
      "he": "בּוֹאוּ נַקְשִׁיב לְסִפּוּר.",
      "voice": "בואו נקשיב לסיפור.",
      "review": "text-ready"
    },
    {
      "id": "f22",
      "vo": "vo:rus.f22",
      "he": "מַה יִּקְרֶה עַכְשָׁו?",
      "voice": "מה יקרה עכשיו?",
      "review": "text-ready"
    },
    {
      "id": "f23",
      "vo": "vo:rus.f23",
      "he": "מִי הָיָה בַּסִּפּוּר?",
      "voice": "מי היה בסיפור?",
      "review": "text-ready"
    },
    {
      "id": "f24",
      "vo": "vo:rus.f24",
      "he": "מַה מָּצָא הַקִּפּוֹד?",
      "voice": "מה מצא הקיפוד?",
      "review": "text-ready"
    },
    {
      "id": "f25",
      "vo": "vo:rus.f25",
      "he": "מָה חִפְּשָׂה הַיַּלְדָּה?",
      "voice": "מה חִפְּשָׂה הילדה?",
      "review": "text-ready"
    },
    {
      "id": "f26",
      "vo": "vo:rus.f26",
      "he": "הַקְשִׁיבוּ לַשִּׁיר.",
      "voice": "הקשיבו לשיר.",
      "review": "text-ready"
    },
    {
      "id": "f27",
      "vo": "vo:rus.f27",
      "he": "אֵיזוֹ מִלָּה מַתְאִימָה לַסּוֹף?",
      "voice": "איזו מילה מתאימה לסוף?",
      "review": "text-ready"
    },
    {
      "id": "f28",
      "vo": "vo:rus.f28",
      "he": "תּוֹפְפוּ עַל הַתֹּף: פַּעַם אַחַת לְכׇל חֵלֶק בַּמִּלָּה.",
      "voice": "תופפו על התוף: פעם אַחַת לכל חלק במילה.",
      "review": "text-ready"
    },
    {
      "id": "f29",
      "vo": "vo:rus.f29",
      "he": "בְּאֵיזוֹ תְּמוּנָה יֵשׁ שָׁלוֹשׁ מְחִיאוֹת כַּפַּיִם?",
      "voice": "באיזו תמונה יש שָׁלוֹשׁ מחיאות כפיים?",
      "review": "text-ready"
    },
    {
      "id": "f30",
      "vo": "vo:rus.f30",
      "he": "בְּאֵיזוֹ תְּמוּנָה יֵשׁ שְׁתֵּי מְחִיאוֹת כַּפַּיִם?",
      "voice": "באיזו תמונה יש שְׁתֵּי מחיאות כפיים?",
      "review": "text-ready"
    },
    {
      "id": "f31",
      "vo": "vo:rus.f31",
      "he": "בְּאֵיזוֹ תְּמוּנָה יֵשׁ מְחִיאַת כַּפַּיִם אַחַת?",
      "voice": "באיזו תמונה יש מחיאת כפיים אַחַת?",
      "review": "text-ready"
    },
    {
      "id": "f32",
      "vo": "vo:rus.f32",
      "he": "בְּאֵיזוֹ תְּמוּנָה הַמִּלָּה מַתְחִילָה אוֹתוֹ דָּבָר?",
      "voice": "באיזו תמונה המילה מתחילה אותו דבר?",
      "review": "text-ready"
    },
    {
      "id": "f33",
      "vo": "vo:rus.f33",
      "he": "הַמִּלִּים מַתְחִילוֹת אוֹתוֹ דָּבָר?",
      "voice": "המילים מתחילות אותו דבר?",
      "review": "text-ready"
    },
    {
      "id": "f34",
      "vo": "vo:rus.f34",
      "he": "הַקְשִׁיבוּ לִשְׁתֵּי הַמִּלִּים. אוֹתוֹ דָּבָר, אוֹ לֹא?",
      "voice": "הקשיבו לִשְׁתֵּי המילים. אותו דבר, או לא?",
      "review": "text-ready"
    },
    {
      "id": "f35",
      "vo": "vo:rus.f35",
      "he": "אֵיזוֹ מִלָּה שְׁמַעְתֶּם?",
      "voice": "איזו מילה שמעתם?",
      "review": "text-ready"
    },
    {
      "id": "f36",
      "vo": "vo:rus.f36",
      "he": "הִסְתַּכְּלוּ עַל הַפֶּה.",
      "voice": "הסתכלו על הפה.",
      "review": "text-ready"
    },
    {
      "id": "f38",
      "vo": "vo:rus.f38",
      "he": "אֵיזוֹ מִלָּה מַתְאִימָה לַתְּמוּנָה?",
      "voice": "איזו מילה מתאימה לתמונה?",
      "review": "text-ready"
    },
    {
      "id": "f39",
      "vo": "vo:rus.f39",
      "he": "מִישֶׁהוּ בָּא, אוֹ הוֹלֵךְ?",
      "voice": "מישהו בא, או הולך?",
      "review": "text-ready"
    },
    {
      "id": "f40",
      "vo": "vo:rus.f40",
      "he": "כַּמָּה יֵשׁ? הַקְשִׁיבוּ לַכַּפְתּוֹרִים, וּגְעוּ בַּמִּסְפָּר הַנָּכוֹן.",
      "voice": "כמה יש? הקשיבו לכפתורים, וגעו במספר הנכון.",
      "review": "text-ready"
    },
    {
      "id": "he-fb-check",
      "vo": "vo:rus.he_fb_check",
      "he": "הַמְּמ… בּוֹאוּ נִבְדֹּק.",
      "voice": "המממ… בואו נבדוק.",
      "review": "text-ready"
    },
    {
