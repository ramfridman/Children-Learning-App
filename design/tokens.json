  "font": {
    "families": {
      "display": {
        "value": "'Secular One', 'Heebo', sans-serif",
        "use": "Wordmark, screen titles, celebration words. Niqqud-safe (Open Siddur 'niqqud only' tier; stress string passes)."
      },
      "text": {
        "value": "'Heebo', sans-serif",
        "use": "All captions (with niqqud), numerals, buttons, parent UI. Niqqud-safe; includes Latin digits."
      },
      "$rejected": "Rubik and Fredoka: niqqud positioning errors (Open Siddur survey, confirmed in local render of כׇּל הַכָּבוֹד · שֻׁלְחָן · בְּקֻבּוּץ · אֳנִיָּה). Not used anywhere. Noto Sans Hebrew: no Latin digits."
    },
    "googleFontsHref": "https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&family=Secular+One&display=swap",
    "weights": {
