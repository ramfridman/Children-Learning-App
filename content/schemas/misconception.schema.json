{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nitznutz:schema:misconception",
  "title": "Nitznutz misconception",
  "type": "object",
  "properties": {
    "schema": {
      "const": "misconception/v1"
    },
    "id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 36,
      "pattern": "^(?:M-[A-Z]{2,5}-[A-Z0-9]{2,12}|[a-z]{3}\\.[a-z]{2,4}\\.[a-z0-9_]{1,24})$"
    },
    "review": {
      "type": "string",
      "enum": [
        "needs-editor",
        "approved"
      ]
    },
    "course": {
      "type": "string",
      "enum": [
        "core",
        "eng",
        "heb",
        "rus"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "diagnostic",
        "on_the_way",
        "accent",
        "practice"
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "DIR",
        "NAME",
        "SHAPE",
        "STROKE",
        "CONTRAST",
        "SEGMENT",
        "RHYME",
        "VOWEL",
        "CODE",
        "GRAMMAR",
        "PRINT",
        "GUESS",
        "MEANING",
        "ACCENT",
        "FLUENCY"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 6,
        "maxLength": 14,
        "pattern": "^(?:[A-Z]{2,5}-[ABC]-\\d{2}(?:\\.[A-Z][0-9]{1,2})?)$"
      },
      "minItems": 1,
      "maxItems": 60
    },
    "parentText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "homeActivity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "const": "he"
          },
          "v": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "t",
          "v"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    },
    "repairActivities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 81,
        "pattern": "^(?:[a-z0-9][a-z0-9._-]{2,80})$"
      },
      "minItems": 0,
      "maxItems": 10
    },
    "preferredRepresentations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "concrete",
          "pictorial",
          "story",
          "embodied",
          "symbolic"
        ]
      },
      "minItems": 0,
      "maxItems": 5
    }
  },
  "required": [
    "schema",
    "id",
    "skills",
    "parentText",
    "repairActivities",
    "preferredRepresentations"
  ],
  "additionalProperties": false
}
