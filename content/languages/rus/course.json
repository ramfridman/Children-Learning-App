  "tags": {
    "sem": {
      "id": "rus.lis.sem",
      "tag": "M-RUS-SEM",
      "kind": "diagnostic",
      "family": "MEANING",
      "parentText": "הילד כבר מכיר את הנושא, ומילים קרובות (כמו שתי חיות) עדיין מתחלפות לפעמים. זה רגיל בלמידת מילים חדשות.",
      "homeActivity": "הניחו שני חפצים מאותו נושא, אמרו ברוסית את השם של אחד מהם, ובקשו מהילד להצביע עליו.",
      "preferredRepresentations": [
        "story"
      ]
    },
    "sound": {
      "id": "rus.voc.sound",
      "tag": "M-RUS-SOUND",
      "kind": "diagnostic",
      "family": "GUESS",
      "parentText": "מילים שנשמעות דומה (сок ו־суп) עדיין מתחלפות לילד. זה שלב רגיל בלמידת שפה חדשה.",
      "homeActivity": "אמרו לאט שתי מילים דומות, אחת אחרי השנייה, והצביעו על התמונה של כל אחת.",
      "preferredRepresentations": [
        "pictorial"
      ]
    },
    "kto": {
      "id": "rus.grm.kto",
      "tag": "M-RUS-KTO",
      "kind": "diagnostic",
      "family": "GRAMMAR",
      "parentText": "ברוסית שואלים кто (\"מי\") על אנשים ועל בעלי חיים, ו־что (\"מה\") על חפצים. בעברית אומרים \"מה זה?\" גם על חתול, ולכן זה מבלבל בהתחלה.",
      "homeActivity": "בספר תמונות: על חיה או על אדם שאלו \"Кто это?\", ועל חפץ שאלו \"Что это?\".",
      "preferredRepresentations": [
        "story"
      ]
    },
    "tyvy": {
      "id": "rus.lis.tyvy",
      "tag": "M-RUS-TYVY",
      "kind": "diagnostic",
      "family": "GRAMMAR",
      "parentText": "למבוגר שאינו מהמשפחה אומרים ברוסית здравствуйте ו־до свидания, ולחבר привет ו־пока. זו הצורה המנומסת; במשפחה ובין חברים מדברים כרגיל.",
      "homeActivity": "כשפוגשים מבוגר שמדבר רוסית, אמרו יחד \"здравствуйте\".",
      "preferredRepresentations": [
        "story"
      ]
    },
    "yesno": {
      "id": "rus.grm.yesno",
      "tag": "M-RUS-YESNO",
      "kind": "diagnostic",
      "family": "GUESS",
      "parentText": "אם הילד עונה כל פעם אותה תשובה בשאלות של כן ולא, או בשאלות של אותו דבר או לא, כנראה שהשאלה עדיין לא ברורה לו עד הסוף. זה נורמלי בהתחלה.",
      "homeActivity": "שאלו בצחוק \"Это кот?\" על דברים בבית, לפעמים נכון ולפעמים לא, וענו יחד да או нет.",
      "preferredRepresentations": [
        "pictorial"
      ]
    },
    "numword": {
      "id": "rus.num.numword",
      "tag": "M-RUS-NUMWORD",
      "kind": "diagnostic",
      "family": "MEANING",
      "parentText": "כשהילד מתבלבל בין מספרים סמוכים (три ו־четыре), ייתכן שמילת המספר ברוסית עדיין חדשה לו, או שהכמות עצמה עדיין חדשה לו. זה רגיל בגיל הזה.",
      "homeActivity": "ספרו יחד ברוסית דברים בבית: מדרגות, כפיות, צעצועים.",
      "preferredRepresentations": [
        "concrete"
      ]
    },
    "rhyme_onset": {
      "id": "rus.pho.rhyme_onset",
      "tag": "M-RUS-RHYME-ONSET",
      "kind": "diagnostic",
      "family": "RHYME",
      "parentText": "כשמחפשים חרוז, ילדים בוחרים לפעמים מילה שמתחילה אותו דבר (нос ו־ноги) במקום מילה שנגמרת אותו דבר.",
      "homeActivity": "אמרו שתי מילים מתחרזות ברוסית (кот – рот) ושאלו: נשמע דומה בסוף?",
      "preferredRepresentations": [
        "pictorial"
      ]
    },
    "syll": {
      "id": "rus.pho.syll",
      "tag": "M-RUS-SYLL",
      "kind": "diagnostic",
      "family": "SEGMENT",
      "parentText": "בספירת חלקי מילה במחיאות כפיים, קורה שהילד מוחא פעם אחת יותר או פחות.",
      "homeActivity": "מחאו כפיים יחד לכל חלק בשמות של צעצועים: ку-кла, ма-ши-на.",
      "preferredRepresentations": [
        "embodied"
      ]
    },
    "notfirst": {
      "id": "rus.pho.notfirst",
      "tag": "M-RUS-NOTFIRST",
      "kind": "diagnostic",
      "family": "SEGMENT",
      "parentText": "הילד שומע את הצליל במילה, אבל עוד לא ברור לו שהוא בהתחלה.",
      "homeActivity": "משחק \"מה מתחיל ב־ммм?\": משכו את הצליל הראשון של מילה, ומצאו עוד דבר שמתחיל כך.",
      "preferredRepresentations": [
        "pictorial"
      ]
    },
    "seq": {
      "id": "rus.lis.seq",
      "tag": "M-RUS-SEQ",
      "kind": "diagnostic",
      "family": "MEANING",
      "parentText": "אחרי הסיפור הילד בחר תמונה שלא הייתה בו. כדאי להקשיב לסיפור שוב, עם התמונות.",
      "homeActivity": "קראו יחד ספר תמונות ושאלו \"מה יקרה עכשיו?\" לפני שמדפדפים.",
      "preferredRepresentations": [
        "story"
      ]
    },
    "hardsoft": {
      "id": "rus.pho.hardsoft",
      "tag": "M-RUS-HARDSOFT",
      "kind": "diagnostic",
      "family": "CONTRAST",
      "parentText": "ברוסית יש עיצורים \"רכים\" ו\"קשים\" (лук \"בצל\", люк \"מכסה בכביש\"). בעברית אין הבדל כזה, ולכן לוקח זמן לשמוע אותו.",
      "homeActivity": "אמרו את הזוג лук – люк, עם חיוך רחב ב־люк, ושחקו \"איזו מילה שמעתם?\".",
      "preferredRepresentations": [
        "pictorial"
      ]
    },
    "yi": {
      "id": "rus.pho.yi",
      "tag": "M-RUS-YI",
      "kind": "diagnostic",
      "family": "CONTRAST",
      "parentText": "הצליל ы לא קיים בעברית, ולכן мышка (\"עכבר\") ו־мишка (\"דובי\") נשמעות דומה.",
      "homeActivity": "עשו יחד \"פרצוף מתלבט\" ואמרו ы…, ואחר כך мышка ו־мишка.",
      "preferredRepresentations": [
        "pictorial"
      ]
    }
  },
  "lines": {
    "f01": {
      "he": "הַקְשִׁיבוּ, וּגְעוּ בַּתְּמוּנָה.",
      "voice": "הקשיבו, וגעו בתמונה.",
      "review": "text-ready"
    },
    "f02": {
      "he": "הַקְשִׁיבוּ שׁוּב.",
      "voice": "הקשיבו שוב.",
      "review": "text-ready"
    },
    "f03": {
      "he": "בּוֹאוּ נֹאמַר יַחַד.",
      "voice": "בואו נגיד יחד.",
      "review": "text-ready"
    },
    "f04": {
      "he": "שָׁמַעְתִּי:",
      "voice": "שמעתי:",
      "review": "text-ready"
    },
    "f05": {
      "he": "עַכְשָׁו אַתֶּם.",
      "voice": "עכשיו אתם.",
      "review": "text-ready"
    },
    "f06": {
      "he": "מַה זֶּה? נַסּוּ לְהַגִּיד בְּרוּסִית.",
      "voice": "מה זה? נסו להגיד ברוסית.",
      "review": "text-ready"
    },
    "f07": {
      "he": "מָה עוֹנִים לֶחָבֵר?",
      "voice": "מה עונים לֶחָבֵר?",
      "review": "text-ready"
    },
    "f08": {
      "he": "הַקְשִׁיבוּ, וּמִצְאוּ אֶת זֶה אֵצֶל הֶחָבֵר.",
      "voice": "הקשיבו, ומצאו את זה אצל החבר.",
      "review": "text-ready"
    },
    "f09": {
      "he": "הַקְשִׁיבוּ, וְעִזְרוּ לֶחָבֵר לַעֲשׂוֹת אֶת זֶה.",
      "voice": "הקשיבו, ועזרו לֶחָבֵר לַעֲשׂוֹת את זה.",
      "review": "text-ready"
    },
    "f10": {
      "he": "עַכְשָׁו אַתֶּם! עֲשׂוּ אֶת זֶה, וְאָז גְּעוּ בַּכַּפְתּוֹר.",
      "voice": "עכשיו אתם, עֲשׂוּ את זה, ואז געו בכפתור.",
      "review": "text-ready"
    },
    "f11": {
      "he": "הַקְשִׁיבוּ, וְשִׂימוּ אֶת זֶה בַּצַּלַּחַת שֶׁל הֶחָבֵר.",
      "voice": "הקשיבו, וְשִׂימוּ את זה בצלחת של החבר.",
      "review": "text-ready"
    },
    "f12": {
      "he": "הַקְשִׁיבוּ, וְשִׂימוּ אֶת זֶה בַּקֻּפְסָה.",
      "voice": "הקשיבו, וְשִׂימוּ את זה בקופסה.",
      "review": "text-ready"
    },
    "f13": {
      "he": "הַקְשִׁיבוּ, וְהַלְבִּישׁוּ אֶת הֶחָבֵר.",
      "voice": "הקשיבו, והלבישו את החבר.",
      "review": "text-ready"
    },
    "f14": {
      "he": "הַקְשִׁיבוּ, וּגְעוּ בַּצֶּבַע.",
      "voice": "הקשיבו, וגעו בצבע.",
      "review": "text-ready"
    },
    "f15": {
      "he": "בּוֹאוּ נִסְפֹּר יַחַד.",
      "voice": "בואו נספור יחד.",
      "review": "text-ready"
    },
    "f16": {
      "he": "הַקְשִׁיבוּ לַמִּסְפָּר, וּגְעוּ בַּתְּמוּנָה.",
