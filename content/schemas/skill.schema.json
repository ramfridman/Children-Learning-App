{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nitznutz:schema:skill",
  "title": "Nitznutz skill",
  "type": "object",
  "properties": {
    "schema": {
      "const": "skill/v1"
    },
    "id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 11,
      "pattern": "^(?:[A-Z]{2,5}-[ABC]-\\d{2})$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "numbers",
        "colors",
        "shapes",
        "logic",
        "cs",
        "math"
      ]
    },
    "band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "title": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "const": "he"
          },
          "v": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "t",
          "v"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 6,
            "maxLength": 11,
            "pattern": "^(?:[A-Z]{2,5}-[ABC]-\\d{2})$"
          },
          "weight": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "required": [
          "skill",
          "weight"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "concrete",
          "pictorial",
          "story",
          "embodied",
          "symbolic"
        ]
      },
      "minItems": 1,
      "maxItems": 5
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 20,
        "pattern": "^(?:M-[A-Z]{2,5}-[A-Z0-9]{2,12})$"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "retention": {
      "type": "object",
      "properties": {
        "targetRetention": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.0
        },
        "initialStabilityDays": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 30.0
        }
      },
      "required": [
        "targetRetention",
        "initialStabilityDays"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "domain",
    "band",
    "title",
    "prerequisites",
    "representations",
    "misconceptions",
    "retention"
  ],
  "additionalProperties": false
}
