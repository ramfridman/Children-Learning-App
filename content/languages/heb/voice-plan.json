      "shown": "הַכַּדּוּר נוֹפֵל לְתוֹךְ הַשִּׂיחַ. אֵיפֹה הוּא?",
      "say": "הכדור נופל לתוך הַשִּׂיחַ. איפה הוא?",
      "ipa": "[hakaˈduʁ noˈfel leˈtoχ haˈsiaχ ˈefo hu]"
    },
    {
      "id": "heb-a-s1-p4",
      "vo": "vo:heb.heb_a_s1_p4",
      "shown": "הַחֲתוּלָה מְחַפֶּשֶׂת בַּשִּׂיחַ. הִנֵּה הַכַּדּוּר!",
      "say": "החתולה מְחַפֶּשֶׂת בַּשִּׂיחַ. הנה הכדור.",
      "ipa": "[haχatuˈla meχaˈpeset baˈsiaχ hiˈne hakaˈduʁ]"
    },
    {
      "id": "heb-a-s1-p5",
      "vo": "vo:heb.heb_a_s1_p5",
      "shown": "עַכְשָׁו הָאַרְנָב וְהַחֲתוּלָה מְשַׂחֲקִים יַחַד.",
      "say": "עכשיו הארנב והחתולה מְשַׂחֲקִים יחד.",
      "ipa": "[aχˈʃav haaʁˈnav vehaχatuˈla mesaχaˈkim ˈjaχad]"
    },
    {
      "id": "heb-a-s1-r1",
      "vo": "vo:heb.heb_a_s1_r1",
      "shown": "נָכוֹן! הַכַּדּוּר נָפַל לְתוֹךְ הַשִּׂיחַ.",
      "say": "נכון, הכדור נפל לתוך הַשִּׂיחַ.",
      "ipa": "[naˈχon hakaˈduʁ naˈfal leˈtoχ haˈsiaχ]"
    },
    {
      "id": "heb-a-s1-r2",
      "vo": "vo:heb.heb_a_s1_r2",
      "shown": "נָכוֹן! הַחֲתוּלָה מָצְאָה אֶת הַכַּדּוּר.",
      "say": "נכון, החתולה מצאה את הכדור.",
      "ipa": "[naˈχon haχatuˈla matsˈa et hakaˈduʁ]"
    },
    {
      "id": "heb-a-s2-p1",
      "vo": "vo:heb.heb_a_s2_p1",
      "shown": "נִיצִי רוֹצָה לֶאֱפוֹת עוּגָה.",
      "say": "ניצי רוצה לאפות עוגה.",
      "ipa": "[ˈnitsi ʁoˈtsa leeˈfot uˈga]"
    },
    {
      "id": "heb-a-s2-p2",
      "vo": "vo:heb.heb_a_s2_p2",
      "shown": "הִיא שָׂמָה קֶמַח וּבֵיצָה בַּקְּעָרָה.",
      "say": "היא שָׂמָה קמח וביצה בקערה.",
      "ipa": "[hi saˈma ˈkemaχ uveˈtsa bakeaˈʁa]"
    },
    {
      "id": "heb-a-s2-p3",
      "vo": "vo:heb.heb_a_s2_p3",
      "shown": "הִיא מְעַרְבֶּבֶת, מְעַרְבֶּבֶת, מְעַרְבֶּבֶת.",
      "say": "היא מערבבת, מערבבת, מערבבת.",
      "ipa": "[hi meaʁˈbevet meaʁˈbevet meaʁˈbevet]"
    },
    {
      "id": "heb-a-s2-p4",
      "vo": "vo:heb.heb_a_s2_p4",
      "shown": "הָעוּגָה נִכְנֶסֶת לַתַּנּוּר.",
      "say": "העוגה נכנסת לתנור.",
      "ipa": "[hauˈga niχˈneset lataˈnuʁ]"
    },
    {
      "id": "heb-a-s2-p5",
      "vo": "vo:heb.heb_a_s2_p5",
      "shown": "אֵיזֶה רֵיחַ טוֹב! כֻּלָּם אוֹכְלִים עוּגָה.",
      "say": "איזה ריח טוב. כולם אוכלים עוגה.",
      "ipa": "[ˈeze ˈʁeaχ tov kuˈlam oχˈlim uˈga]"
    },
    {
      "id": "heb-a-s2-r1",
      "vo": "vo:heb.heb_a_s2_r1",
      "shown": "נָכוֹן! נִיצִי שָׂמָה בֵּיצָה בַּקְּעָרָה.",
      "say": "נכון, ניצי שָׂמָה ביצה בקערה.",
      "ipa": "[naˈχon ˈnitsi saˈma beˈtsa bakeaˈʁa]"
    },
    {
      "id": "heb-a-s2-r2",
      "vo": "vo:heb.heb_a_s2_r2",
      "shown": "נָכוֹן! הָעוּגָה נִכְנְסָה לַתַּנּוּר.",
      "say": "נכון, העוגה נכנסה לתנור.",
      "ipa": "[naˈχon hauˈga niχneˈsa lataˈnuʁ]"
    },
    {
      "id": "heb-a-s3-p1",
      "vo": "vo:heb.heb_a_s3_p1",
      "shown": "קוּבִּי הַצָּב יוֹשֵׁב בְּסִירָה קְטַנָּה.",
      "say": "קובי הצב יושב בסירה קטנה.",
      "ipa": "[ˈkubi haˈtsav joˈʃev besiˈʁa ktaˈna]"
    },
    {
      "id": "heb-a-s3-p2",
      "vo": "vo:heb.heb_a_s3_p2",
      "shown": "פִּתְאוֹם רוּחַ חֲזָקָה! הַכּוֹבַע עָף.",
      "say": "פתאום רוח חזקה. הכובע עף.",
      "ipa": "[pitˈom ˈʁuaχ χazaˈka haˈkova af]"
    },
    {
      "id": "heb-a-s3-p3",
      "vo": "vo:heb.heb_a_s3_p3",
      "shown": "הַכּוֹבַע נוֹפֵל לַמַּיִם.",
      "say": "הכובע נופל למים.",
      "ipa": "[haˈkova noˈfel laˈmajim]"
    },
    {
      "id": "heb-a-s3-p4",
      "vo": "vo:heb.heb_a_s3_p4",
      "shown": "דָּג קָטָן שׂוֹחֶה וּמֵבִיא אֶת הַכּוֹבַע.",
      "say": "דג קטן שׂוֹחֶה ומביא את הכובע.",
      "ipa": "[dag kaˈtan soˈχe umeˈvi et haˈkova]"
    },
    {
      "id": "heb-a-s3-p5",
      "vo": "vo:heb.heb_a_s3_p5",
      "shown": "\"תּוֹדָה, דָּג!\" אוֹמֵר קוּבִּי.",
      "say": "תודה, דג, אומר קובי.",
      "ipa": "[toˈda dag oˈmeʁ ˈkubi]"
    },
    {
      "id": "heb-a-s3-r1",
      "vo": "vo:heb.heb_a_s3_r1",
      "shown": "נָכוֹן! הַכּוֹבַע עָף בָּרוּחַ.",
      "say": "נכון, הכובע עף ברוח.",
      "ipa": "[naˈχon haˈkova af baˈʁuaχ]"
    },
    {
      "id": "heb-a-s3-r2",
      "vo": "vo:heb.heb_a_s3_r2",
      "shown": "נָכוֹן! הַדָּג הֵבִיא אֶת הַכּוֹבַע.",
