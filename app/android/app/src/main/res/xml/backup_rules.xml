<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing from this app is ever backed up (Android 11 and older). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
