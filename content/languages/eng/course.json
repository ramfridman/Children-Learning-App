  "tags": {
    "sem": {"id": "eng.lis.sem", "tag": "M-ENG-SEM", "kind": "diagnostic", "family": "MEANING", "parentText": "הילד כבר מכיר את הנושא, ומילים קרובות באנגלית (כמו hello ו־goodbye) עדיין מתחלפות לפעמים. זה רגיל בלמידת מילים חדשות.", "homeActivity": "שחקו \"מה אני עושה?\": אחד אומר מילה באנגלית (cat, dog), השני מראה את התמונה או התנועה. כדאי לשים שתי מילים קרובות זו ליד זו.", "preferredRepresentations": ["pictorial", "embodied"]},
    "l1_guess": {"id": "eng.lis.l1_guess", "tag": "M-ENG-L1-GUESS", "kind": "diagnostic", "family": "GUESS", "parentText": "לפעמים הילד בוחר את התמונה המוכרת לו ביותר, ולא את מה ששמע באנגלית. כדאי להקשיב יחד שוב, עם התמונה.", "homeActivity": "כשמקשיבים יחד, אפשר לעצור לפני שבוחרים ולשאול: \"מה שמענו?\", ורק אז לגעת.", "preferredRepresentations": ["pictorial"]},
    "syll": {"id": "eng.pa.syll", "tag": "M-ENG-SYLL", "kind": "diagnostic", "family": "SEGMENT", "parentText": "הילד מוסיף לפעמים פעימה למילה באנגלית (כמו \"סְטוֹפָּה\" במקום stop). זה טבעי לדוברי עברית, וזה עובר בתרגול.", "homeActivity": "מחאו כפיים יחד על מילים באנגלית, לאט: cat (אחת), apple (שתיים), banana (שלוש).", "preferredRepresentations": ["concrete", "embodied"]},
    "weak_syll": {"id": "eng.pa.weak_syll", "tag": "M-ENG-WEAK-SYLL", "kind": "diagnostic", "family": "SEGMENT", "parentText": "הילד מדלג לפעמים על החלק השקט של המילה (banana נשמעת לו כשתי פעימות). אוזן צעירה שומעת קודם את החלקים החזקים.", "homeActivity": "אמרו את המילה לאט, וגעו באצבע לכל חלק: ba-na-na. אחר כך מתופפים יחד על השולחן.", "preferredRepresentations": ["concrete", "embodied"]},
    "yesno": {"id": "eng.lis.yesno", "tag": "M-ENG-YESNO", "kind": "diagnostic", "family": "GUESS", "parentText": "בשאלות כן או לא הילד עונה לפעמים אותה תשובה לכל שאלה, בלי להסתכל בתמונה. זה שלב רגיל, והאפליקציה מאזנת את השאלות.", "homeActivity": "שחקו \"זה חתול?\" עם צעצועים בבית: לפעמים כן ולפעמים לא, עם הנהון או ניעור ראש.", "preferredRepresentations": ["pictorial"]},
    "story_recall": {"id": "eng.lis.story_recall", "tag": "M-ENG-STORY-RECALL", "kind": "diagnostic", "family": "MEANING", "parentText": "בשאלה על הסיפור הילד בחר משהו שהופיע בעמוד אחר. כדאי לחזור יחד לעמוד ולהצביע.", "homeActivity": "אחרי סיפור, שאלו \"מה קרה בסוף?\" ודפדפו יחד לעמוד הנכון.", "preferredRepresentations": ["story"]}
  },
  "lines": {
    "he-welcome": {"he": "שָׁלוֹם! בָּאִי הַזֶּה מְדַבְּרִים אַנְגְּלִית. בּוֹאוּ נַקְשִׁיב וּנְשַׂחֵק.", "voice": "שלום, באי הזה מדברים אנגלית. בואו נקשיב וּנְשַׂחֵק.", "review": "text-ready"},
    "he-bye": {"he": "לְהִתְרָאוֹת! הָיָה כֵּיף לְשַׂחֵק בְּאַנְגְּלִית.", "voice": "להתראות, היה כיף לְשַׂחֵק באנגלית.", "review": "text-ready"},
    "he-ins-listen-tap": {"he": "הַקְשִׁיבוּ, וּגְעוּ בַּתְּמוּנָה.", "voice": "הקשיבו, וגעו בתמונה.", "review": "text-ready"},
    "he-ins-who-doing": {"he": "הַקְשִׁיבוּ, וּגְעוּ בַּתְּמוּנָה שֶׁל הַפְּעֻלָּה.", "voice": "הקשיבו, וגעו בתמונה של הפעולה.", "review": "text-ready"},
    "he-ins-make-do": {"he": "הַקְשִׁיבוּ, וְהַרְאוּ לְמִיקָה מַה לַּעֲשׂוֹת: גְּעוּ בַּכַּפְתּוֹר.", "voice": "הקשיבו, והראו למיקה מה לַעֲשׂוֹת: געו בכפתור.", "review": "text-ready"},
    "he-ins-do-too": {"he": "עַכְשָׁו אַתֶּם! עֲשׂוּ אֶת זֶה, וְאָז גְּעוּ בַּכַּפְתּוֹר \"סִיַּמְתִּי\".", "voice": "עכשיו אתם, עֲשׂוּ את זה, ואז געו בכפתור — סיימתי.", "review": "text-ready"},
    "he-ins-count": {"he": "בּוֹאוּ נִסְפֹּר בְּאַנְגְּלִית. גְּעוּ בְּכׇל אֶחָד.", "voice": "בואו נספור באנגלית. געו בכל אֶחָד.", "review": "text-ready"},
    "he-ins-how-many": {"he": "כַּמָּה יֵשׁ? הַקְשִׁיבוּ לַכַּפְתּוֹרִים, וּגְעוּ בַּמִּסְפָּר הַנָּכוֹן.", "voice": "כמה יש? הקשיבו לכפתורים, וגעו במספר הנכון.", "review": "text-ready"},
    "he-ins-touch-body": {"he": "הַקְשִׁיבוּ, וּגְעוּ בַּגּוּף שֶׁל מִיקָה.", "voice": "הקשיבו, וגעו בגוף של מיקה.", "review": "text-ready"},
    "he-ins-give": {"he": "הַקְשִׁיבוּ, וְגִרְרוּ אֶת הָאֹכֶל לְפִיפּ.", "voice": "הקשיבו, וגררו את הָאֹכֶל לפיפ.", "review": "text-ready"},
    "he-ins-give-it": {"he": "הַקְשִׁיבוּ, וְגִרְרוּ לְפִיפּ:", "voice": "הקשיבו, וגררו לפיפ:", "review": "needs-editor"},
    "he-ins-which-word": {"he": "אֵיזוֹ מִלָּה מַתְאִימָה לַתְּמוּנָה?", "voice": "איזו מילה מתאימה לתמונה?", "review": "needs-editor"},
    "he-ins-say": {"he": "עַכְשָׁו תּוֹרְכֶם. אִמְרוּ גַּם אַתֶּם!", "voice": "עכשיו תורכם. אִמְרוּ גם אתם.", "review": "text-ready"},
    "he-ins-mic": {"he": "גְּעוּ בַּמִּיקְרוֹפוֹן, וְאִמְרוּ.", "voice": "געו במיקרופון, וְאִמְרוּ.", "review": "text-ready"},
    "he-ins-said-it": {"he": "אָמַרְתֶּם? גְּעוּ בַּכַּפְתּוֹר \"אָמַרְתִּי\".", "voice": "אמרתם? געו בכפתור — אמרתי.", "review": "text-ready"},
    "he-ins-find-said": {"he": "וְעַכְשָׁו גְּעוּ בַּתְּמוּנָה שֶׁל הַמִּלָּה.", "voice": "ועכשיו געו בתמונה של המילה.", "review": "text-ready"},
    "he-ins-drum": {"he": "הַקְשִׁיבוּ לַמִּלָּה, וְתוֹפְפוּ פַּעַם אַחַת לְכׇל חֵלֶק.", "voice": "הקשיבו למילה, ותופפו פעם אַחַת לכל חלק.", "review": "text-ready"},
    "he-ins-strip": {"he": "כַּמָּה תֻּפִּים? גְּעוּ בַּשּׁוּרָה הַנְּכוֹנָה.", "voice": "כמה תופים? געו בשורה הנכונה.", "review": "text-ready"},
    "he-ins-story": {"he": "בּוֹאוּ נִשְׁמַע סִפּוּר. אֶפְשָׁר לָגַעַת בַּתְּמוּנוֹת.", "voice": "בואו נשמע סיפור. אפשר לגעת בתמונות.", "review": "text-ready"},
    "he-q-who": {"he": "מִי זֶה?", "voice": "מי זה?", "review": "text-ready"},
    "he-q-ball-end": {"he": "אֵצֶל מִי הַכַּדּוּר בַּסּוֹף?", "voice": "אצל מי הכדור בסוף?", "review": "text-ready"},
    "he-q-ball-which": {"he": "אֵיזֶה כַּדּוּר הָיָה בַּסִּפּוּר?", "voice": "איזה כדור היה בסיפור?", "review": "text-ready"},
    "he-q-ball-first": {"he": "לְיַד מִי הַכַּדּוּר קָפַץ בַּהַתְחָלָה?", "voice": "ליד מי הכדור קפץ בהתחלה?", "review": "text-ready"},
    "he-ins-thumbs": {"he": "כֵּן אוֹ לֹא? גְּעוּ בַּאֲגוּדָל.", "voice": "כן או לא? געו באגודל.", "review": "text-ready"},
    "he-ins-box": {"he": "מַה יֵּשׁ בַּקֻּפְסָה? הַקְשִׁיבוּ לְפִיפּ.", "voice": "מה יש בקופסה? הקשיבו לפיפ.", "review": "text-ready"},
    "he-ins-box-pick": {"he": "אָז מַה יֵּשׁ בַּקֻּפְסָה? גְּעוּ בַּתְּמוּנָה.", "voice": "אז מה יש בקופסה? געו בתמונה.", "review": "text-ready"},
    "he-ins-bubble": {"he": "מָה עוֹנִים? גְּעוּ בַּבֻּעָה.", "voice": "מה עונים? געו בבועה.", "review": "text-ready"},
    "he-ins-face": {"he": "הַקְשִׁיבוּ, וּגְעוּ בַּפַּרְצוּף הַנָּכוֹן.", "voice": "הקשיבו, וגעו בפרצוף הנכון.", "review": "text-ready"},
    "he-ins-chant": {"he": "בּוֹאוּ נְדַקְלֵם יַחַד, וְנַעֲשֶׂה אֶת הַתְּנוּעוֹת!", "voice": "בואו נדקלם יחד, וְנַעֲשֶׂה את התנועות.", "review": "text-ready"},
    "he-ins-pairs": {"he": "מִצְאוּ שְׁתֵּי תְּמוּנוֹת שֶׁהוֹלְכוֹת יַחַד.", "voice": "מצאו שְׁתֵּי תמונות שהולכות יחד.", "review": "text-ready"},
