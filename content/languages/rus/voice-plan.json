      "voice": "הקשבתם יפה.",
      "review": "text-ready"
    },
    {
      "id": "he-fb-right-8",
      "vo": "vo:rus.he_fb_right_8",
      "he": "כׇּל הַכָּבוֹד!",
      "voice": "כל הכבוד.",
      "review": "text-ready"
    },
