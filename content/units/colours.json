  "tagFeedback": {
    "M-COL-NAME": "הַצְּבָעִים דּוֹמִים. בּוֹאוּ נִסְתַּכֵּל שׁוּב, לְאַט.",
    "M-COL-ONEATTR": "יֵשׁ שְׁנֵי דְּבָרִים לִבְדֹּק: מַה זֶּה, וְאֵיזֶה צֶבַע.",
    "M-COL-OBJECT": "דְּבָרִים יְכוֹלִים לִהְיוֹת בְּכַמָּה צְבָעִים. בּוֹאוּ נִסְתַּכֵּל שׁוּב.",
    "M-SORT-SHIFT": "מְחַפְּשִׂים אֶת אוֹתוֹ צֶבַע, לֹא אוֹתוֹ דָּבָר. בּוֹאוּ נִבְדֹּק."
  },
  "misconceptions": [
    {
      "id": "M-COL-NAME",
      "skills": [
        "COL-A-02",
        "COL-A-03"
      ],
      "parent": "הילד קורא לגוון אחד בשם של גוון אחר, למשל כתום 'אדום'.",
      "home": "לשחק בחיפוש צבעים בבית: 'תביא משהו אדום', ואחר כך 'משהו כתום'. אם הילד מתבלבל, להניח את שני הדברים זה ליד זה ולהסתכל יחד.",
      "reps": [
        "concrete",
        "pictorial"
      ]
    },
    {
      "id": "M-COL-OBJECT",
      "skills": [
        "COL-A-05"
      ],
      "parent": "הילד חושב שלכל דבר יש צבע אחד בלבד, ולא מקבל בננה ירוקה.",
      "home": "להראות בננה ירוקה ובננה צהובה בשוק או בתמונה, ולשאול מה זה. לדבר על כך שהפרי משנה צבע כשהוא מבשיל.",
      "reps": [
        "story",
        "concrete"
      ]
    },
    {
      "id": "M-COL-ONEATTR",
      "skills": [
        "COL-A-07"
      ],
      "parent": "הילד שם לב רק לצבע או רק לסוג הדבר, ולא לשניהם יחד.",
      "home": "לבקש 'את הכדור הכחול' כשיש על השולחן כדורים וגם בלונים בצבעים שונים. קודם לבחור את הכדורים, ואחר כך את הכחול.",
      "reps": [
        "concrete",
        "pictorial"
      ]
    },
    {
      "id": "M-SORT-SHIFT",
      "skills": [
        "COL-A-04",
        "LOG-A-03"
      ],
      "parent": "הילד מחליף את כלל המיון באמצע: מתחיל לפי צבע וממשיך לפי צורה.",
      "home": "למיין כפתורים או גרביים לשתי קופסאות ולהגיד בקול את הכלל ('כל האדומים'). אם הילד מחליף כלל, להגיד את הכלל שוב.",
      "reps": [
        "concrete",
        "embodied"
      ]
    }
