  "$meta": {
    "name": "Nitznutz design tokens",
    "version": "1.0.0",
    "units": "Lengths are logical points (iOS pt = Flutter logical px = Android dp). Durations in ms. Colours sRGB hex.",
    "source": "design/tokens.json is the single source of truth. Artboards in design/boards copy these values literally; the Flutter theme imports this file.",
    "orientation": "Phones: landscape only (locked). Tablets: landscape and portrait (OS may override locks on >=600dp).",
