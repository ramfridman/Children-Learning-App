# ---- Secrets and signing material: never commit ----
.env
.env.*
!.env.example
*.p8
*.p12
*.pem
*.key
*.jks
*.keystore
key.properties
# SEC-RS-3: the Gradle release-signing file (docs/setup/ci-m9.md step 7) names the keystore and its passwords
*signing*.properties
service-account*.json
supabase/.env
supabase/functions/.env
supabase/functions/**/.env

# ---- Local tools (downloaded by tools/install-hooks.ps1) ----
tools/bin/

# ---- Build output ----
build/
dist/
out/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
DerivedData/
*.iml
*.ipa
*.apk
*.aab
*.dSYM.zip

# ---- Node / Deno / Supabase local state ----
node_modules/
supabase/.temp/
supabase/.branches/
.deno/

# ---- Generated audio (large files stay out of Git; packs are built and published by tools) ----
tools/voice_gen/output/
*.wav
*.flac

# ---- The bundled voices (about 98 MiB; the repository is public and the voices are the owner's paid work) ----
# Copied in at build time by tools/copy-release-voices.ps1 from the owner's voice folder. Never committed.
app/assets/characters/voice-*.nnpack
app/assets/packs/voice-lang-*.nnpack

# ---- Editors and OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# Golden comparison output
app/test/failures/

# ---- Firebase client files: hold a Google API key, kept in 1Password and copied in by hand ----
app/android/app/src/*/google-services.json

# ---- Open security findings stay private while the repo is public ----
docs/security/private/
__pycache__/
