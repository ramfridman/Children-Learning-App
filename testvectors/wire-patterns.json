{
  "about": "Everything sync-push takes in an event (SEC-1, SEC-12): the event's own keys, every key of its data with its pattern, range or values, and the keys each type must carry; what tutor-turn takes as a chosen option; and what alert-create takes (alert_create; only the word categories carry words and may be counted again). sync_test.ts asserts sync-push/handler.ts (spec, DATA, REQUIRED) and tutor-turn/handler.ts (OPTION) equal this file, alerts_test.ts asserts alert-create/handler.ts does; in Dart the app's constants (app/lib/play/response_code.dart), the pack's bounds and the fake server of the sync tests (which refuses what the real one would) read it. A new key, value or wider range goes into the server and this file first (PLAN: Deploy order for the gateway). The examples are the longest codes the templates write; the Deno test pushes each one through the real sync-push.",
  "max_events": 40,
  "event_fields": {
    "id": { "t": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "child_id": { "t": "string", "pattern": "^[A-Za-z0-9-]{8,64}$", "max": 64 },
    "at": { "t": "int", "min": 1500000000000, "max": 4100000000000 },
    "engine": { "t": "int", "min": 1, "max": 1000 },
    "type": { "t": "enum", "values": ["attempt", "session", "reward"] },
    "data": { "t": "object" }
  },
  "data_fields": {
    "activity_id": { "t": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$", "max": 81 },
    "activity_revision": { "t": "int", "min": 0, "max": 100000 },
    "pack_id": { "t": "string", "pattern": "^[a-z0-9-]{3,41}$", "max": 41 },
    "pack_version": { "t": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$", "max": 14 },
    "lesson_id": { "t": "string", "pattern": "^[a-z0-9._-]{0,40}$", "max": 40 },
    "template": { "t": "string", "pattern": "^[a-z_]{2,30}$", "max": 30 },
    "template_version": { "t": "string", "pattern": "^[0-9.]{1,10}$", "max": 10 },
    "skill_id": { "t": "string", "pattern": "^[A-Z]{2,5}-[A-C]-[0-9]{2}$", "max": 11 },
    "result": { "t": "enum", "values": ["correct", "incorrect", "unsure"] },
    "attempt_no": { "t": "int", "min": 1, "max": 1000 },
    "hint_level": { "t": "int", "min": 0, "max": 3 },
    "misconception_tag": { "t": "string", "pattern": "^(M-[A-Z]{2,5}-[A-Z0-9]{2,12})?$", "max": 20 },
    "response": { "t": "string", "pattern": "^[A-Za-z0-9=._-]{0,40}$", "max": 40 },
    "duration_ms": { "t": "int", "min": 0, "max": 3600000 },
    "input": { "t": "enum", "values": ["tap", "voice"] },
    "session_local": { "t": "int", "min": 0, "max": 1000000000 },
    "plan": { "t": "string", "pattern": "^[a-z0-9:._-]{0,80}$", "max": 80 },
    "started_at": { "t": "int", "min": 1500000000000, "max": 4100000000000 },
    "ended_at": { "t": "int", "min": 1500000000000, "max": 4100000000000 },
    "end_reason": { "t": "enum", "values": ["", "finished", "home", "limit"] },
    "kind": { "t": "enum", "values": ["sticker", "star", "trophy", "medal", "decoration"] },
    "key": {
      "t": "string",
      "pattern": "^(sticker:[a-z0-9._-]{1,40}:[0-9]{1,4}|star:[A-Z]{2,5}-[A-C]-[0-9]{2}|trophy:[a-z]{3,12}:(bronze|silver|gold)|medal:[a-z0-9-]{2,30}|deco:[0-9]{1,3})$",
      "max": 80
    }
  },
  "required": {
    "attempt": [
      "activity_id",
      "activity_revision",
      "pack_id",
      "pack_version",
      "template",
      "template_version",
      "skill_id",
      "result",
      "attempt_no"
    ],
    "session": ["plan", "started_at", "session_local"],
    "reward": ["kind", "key"]
  },
  "alert_create": {
    "child_id": {"t": "string", "pattern": "^[A-Za-z0-9-]{8,64}$", "max": 64},
    "category": {"t": "enum", "values": ["pastLimit", "restHours", "gateAttempts", "guessing", "frustration", "inappropriateWords", "disclosure", "absence", "ribbonEarned", "concern"]},
    "severity": {"t": "enum", "values": ["info", "attention", "important"]},
    "count": {"t": "int", "min": 0, "max": 100000},
    "detail": {"t": "string", "pattern": "^[A-Za-z0-9._:=-]*$", "max": 80},
    "words": {"t": "string", "pattern": "^[֐-׿A-Za-z0-9 .,?!'\"-]*$", "max": 200},
    "key": {"t": "string", "pattern": "^[A-Za-z0-9._:=-]{1,120}$", "max": 120},
    "at": {"t": "int", "min": 1500000000000, "max": 4100000000000}
  },
  "alert_word_categories": ["inappropriateWords", "disclosure", "concern"],
  "tutor_option": "^[a-z0-9=-]{1,16}$",
  "examples": {
    "choice": "o2",
    "give_n": "n=4",
    "sort": "i1-b2",
    "share": "b1=3.b2=1",
    "pattern": "01010101",
    "program": "uurrdllu",
    "shape": "p9-s12",
    "pairs": "t0-b4.t1-b3.t2-b2.t3-b1.t4-b0",
    "clock": "12.30",
    "shop": "1280000",
    "trace": "direction"
  }
}
