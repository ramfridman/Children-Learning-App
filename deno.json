{
  "imports": {
    "jose": "npm:jose@6.2.13",
    "postgres": "npm:postgres@3.4.9",
    "cbor-x": "npm:cbor-x@1.6.8",
    "@peculiar/x509": "npm:@peculiar/x509@2.2.0",
    "reflect-metadata": "npm:reflect-metadata@0.2.2"
  },
  "fmt": {
    "lineWidth": 110,
    "include": [
      "supabase/functions/",
      "tools/"
    ]
  },
  "lint": {
    "include": [
      "supabase/functions/",
      "tools/"
    ]
  },
  "test": {
    "include": [
      "supabase/functions/"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check --frozen supabase/functions/ tools/gen-testvector.ts && deno test --frozen --allow-read=testvectors"
  },
  "lock": "deno.lock",
  "nodeModulesDir": "none"
}
