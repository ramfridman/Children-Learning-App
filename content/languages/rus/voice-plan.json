      "review": "text-ready"
    },
    {
      "id": "he-fb-right-5",
      "vo": "vo:rus.he_fb_right_5",
      "he": "בְּדִיּוּק!",
      "voice": "בדיוק.",
      "review": "text-ready"
    },
    {
      "id": "he-fb-right-6",
      "vo": "vo:rus.he_fb_right_6",
      "he": "שְׁמַעְתֶּם טוֹב!",
      "voice": "שמעתם טוב.",
      "review": "text-ready"
    },
    {
      "id": "he-fb-right-7",
      "vo": "vo:rus.he_fb_right_7",
