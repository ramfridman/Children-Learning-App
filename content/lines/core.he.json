{
  "schema": "core-lines/v1",
  "review": "needs-editor",
  "note": "Neutral, plural, with niqqud. Taken from docs/curriculum.md sections 9.1 to 9.3, 10.3 and 10.4 where they exist. No line says the child's name and none refers to the speaker's gender.",
  "lines": [
    { "id": "core.greeting.hello", "text": "שָׁלוֹם! בּוֹאוּ נְשַׂחֵק." },
    { "id": "core.greeting.start", "text": "בּוֹאוּ נַתְחִיל!" },
    { "id": "core.encourage.check", "text": "הַמְּמ… בּוֹאוּ נִבְדֹּק." },
    { "id": "core.placement.done", "text": "יָפֶה מְאֹד! עַכְשָׁו נֵדַע מֵאֵיפֹה לְהַתְחִיל." },
    { "id": "core.encourage.almost", "text": "עוֹד לֹא — אֲבָל כִּמְעַט." },
    { "id": "core.encourage.ways", "text": "נִסִּיתֶם כַּמָּה דְּרָכִים — וְזֶה עָזַר!" },
    { "id": "core.encourage.help", "text": "בִּקַּשְׁתֶּם עֶזְרָה — זֶה חָכָם לְבַקֵּשׁ עֶזְרָה." },
    { "id": "core.encourage.mistake", "text": "טָעִינוּ? מְעֻלֶּה — עַכְשָׁו אֲנַחְנוּ יוֹדְעִים מַה לִּבְדֹּק." },
    { "id": "core.encourage.fixed", "text": "מְצָאתֶם אֶת הַטָּעוּת וְתִקַּנְתֶּם. כׇּל הַכָּבוֹד!" },
    { "id": "core.encourage.persist", "text": "לֹא וִתַּרְתֶּם — וּמְצָאתֶם!" },
    { "id": "core.encourage.checked", "text": "בְּדַקְתֶּם שׁוּב לִפְנֵי שֶׁעֲנִיתֶם. כָּכָה עוֹשִׂים חוֹקְרִים." },
    { "id": "core.encourage.effort", "text": "זֶה הָיָה קָשֶׁה, וְהַמֹּחַ שֶׁלָּכֶם הִתְאַמֵּץ וְגָדַל." },
    { "id": "core.celebrate.well", "text": "כׇּל הַכָּבוֹד!" },
    { "id": "core.thinking.think", "text": "הַמְּמ… בּוֹאוּ נַחְשֹׁב." },
    { "id": "core.thinking.together", "text": "בּוֹאוּ נְגַלֶּה יַחַד!" },
    { "id": "core.listen.again", "text": "לֹא שָׁמַעְתִּי טוֹב — אֶפְשָׁר לְהַגִּיד שׁוּב, אוֹ לִלְחֹץ עַל הַתְּשׁוּבָה." },
    { "id": "core.listen.say", "text": "בְּבַקָּשָׁה, תַּגִּידוּ לִי." },
    { "id": "core.listen.mixed", "text": "אוּפְּס, הָאָזְנַיִם שֶׁלִּי הִתְבַּלְבְּלוּ! אֶפְשָׁר לְהַגִּיד שׁוּב?" },
    { "id": "core.listen.confirm", "text": "שָׁמַעְתִּי… נָכוֹן?" },
    { "id": "core.listen.tap", "text": "אֶפְשָׁר גַּם לִלְחֹץ עַל הַתְּשׁוּבָה." },
    { "id": "core.stuck.later", "text": "נַחֲזֹר לָזֶה בְּפַעַם אַחֶרֶת. בּוֹאוּ נְשַׂחֵק בְּמַשֶּׁהוּ אַחֵר." },
    { "id": "core.breathe.now", "text": "בּוֹאוּ נִנְשֹׁם רֶגַע." },
    { "id": "core.goodbye.next", "text": "לָמַדְנוּ הַיּוֹם הַרְבֵּה. נִתְרָאֶה בַּפַּעַם הַבָּאָה!" },
    { "id": "core.ceremony.bronze", "text": "הִנֵּה גְּבִיעַ בְּרוֹנְזָה בִּשְׁבִילְכֶם!" },
    { "id": "core.ceremony.silver", "text": "הִנֵּה גְּבִיעַ כֶּסֶף בִּשְׁבִילְכֶם!" },
    { "id": "core.ceremony.gold", "text": "הִנֵּה גְּבִיעַ זָהָב בִּשְׁבִילְכֶם!" },
    { "id": "core.ceremony.medal", "text": "הִנֵּה מֵדַלְיָה בִּשְׁבִילְכֶם!" },
    { "id": "core.rest.goodbye", "text": "הָיָה כֵּיף! עַכְשָׁו נָחִים קְצָת, וּנְשַׂחֵק שׁוּב אַחַר כָּךְ." },
    { "id": "core.adventure.welcome.counting", "text": "בּוֹאוּ נֵצֵא לְהַרְפַּתְקָה אֶל גִּבְעוֹת הַסְּפִירָה." },
    { "id": "core.adventure.welcome.colors", "text": "בּוֹאוּ נֵצֵא לְהַרְפַּתְקָה אֶל מִפְרַץ הַצְּבָעִים." },
    { "id": "core.adventure.welcome.shapes", "text": "בּוֹאוּ נֵצֵא לְהַרְפַּתְקָה אֶל יַעַר הַצּוּרוֹת." },
    { "id": "core.adventure.welcome.logic", "text": "בּוֹאוּ נֵצֵא לְהַרְפַּתְקָה אֶל מְעָרַת הַחִידוֹת." },
    { "id": "core.adventure.welcome.robots", "text": "בּוֹאוּ נֵצֵא לְהַרְפַּתְקָה אֶל נְמַל הָרוֹבּוֹטִים." },
    { "id": "core.adventure.welcome.market", "text": "בּוֹאוּ נֵצֵא לְהַרְפַּתְקָה אֶל כְּפַר הַשּׁוּק." },
    { "id": "core.adventure.call_for_help.counting", "text": "מַשֶּׁהוּ שֶׁל גִּבְעוֹת הַסְּפִירָה צָרִיךְ עֶזְרָה. בּוֹאוּ נַעֲזֹר." },
    { "id": "core.adventure.call_for_help.colors", "text": "מַשֶּׁהוּ שֶׁל מִפְרַץ הַצְּבָעִים צָרִיךְ עֶזְרָה. בּוֹאוּ נַעֲזֹר." },
    { "id": "core.adventure.call_for_help.shapes", "text": "מַשֶּׁהוּ שֶׁל יַעַר הַצּוּרוֹת צָרִיךְ עֶזְרָה. בּוֹאוּ נַעֲזֹר." },
    { "id": "core.adventure.call_for_help.logic", "text": "מַשֶּׁהוּ שֶׁל מְעָרַת הַחִידוֹת צָרִיךְ עֶזְרָה. בּוֹאוּ נַעֲזֹר." },
    { "id": "core.adventure.call_for_help.robots", "text": "מַשֶּׁהוּ שֶׁל נְמַל הָרוֹבּוֹטִים צָרִיךְ עֶזְרָה. בּוֹאוּ נַעֲזֹר." },
    { "id": "core.adventure.call_for_help.market", "text": "מַשֶּׁהוּ שֶׁל כְּפַר הַשּׁוּק צָרִיךְ עֶזְרָה. בּוֹאוּ נַעֲזֹר." },
    { "id": "core.adventure.same_land.counting", "text": "בּוֹאוּ נַמְשִׁיךְ בַּהַרְפַּתְקָה שֶׁל גִּבְעוֹת הַסְּפִירָה." },
    { "id": "core.adventure.same_land.colors", "text": "בּוֹאוּ נַמְשִׁיךְ בַּהַרְפַּתְקָה שֶׁל מִפְרַץ הַצְּבָעִים." },
    { "id": "core.adventure.same_land.shapes", "text": "בּוֹאוּ נַמְשִׁיךְ בַּהַרְפַּתְקָה שֶׁל יַעַר הַצּוּרוֹת." },
    { "id": "core.adventure.same_land.logic", "text": "בּוֹאוּ נַמְשִׁיךְ בַּהַרְפַּתְקָה שֶׁל מְעָרַת הַחִידוֹת." },
    { "id": "core.adventure.same_land.robots", "text": "בּוֹאוּ נַמְשִׁיךְ בַּהַרְפַּתְקָה שֶׁל נְמַל הָרוֹבּוֹטִים." },
    { "id": "core.adventure.same_land.market", "text": "בּוֹאוּ נַמְשִׁיךְ בַּהַרְפַּתְקָה שֶׁל כְּפַר הַשּׁוּק." },
    { "id": "core.adventure.other_land.counting", "text": "בּוֹאוּ נְבַקֵּר אֶת גִּבְעוֹת הַסְּפִירָה." },
    { "id": "core.adventure.other_land.colors", "text": "בּוֹאוּ נְבַקֵּר אֶת מִפְרַץ הַצְּבָעִים." },
    { "id": "core.adventure.other_land.shapes", "text": "בּוֹאוּ נְבַקֵּר אֶת יַעַר הַצּוּרוֹת." },
    { "id": "core.adventure.other_land.logic", "text": "בּוֹאוּ נְבַקֵּר אֶת מְעָרַת הַחִידוֹת." },
    { "id": "core.adventure.other_land.robots", "text": "בּוֹאוּ נְבַקֵּר אֶת נְמַל הָרוֹבּוֹטִים." },
    { "id": "core.adventure.other_land.market", "text": "בּוֹאוּ נְבַקֵּר אֶת כְּפַר הַשּׁוּק." },
    { "id": "core.adventure.play_again", "text": "בּוֹאוּ נְשַׂחֵק שׁוּב מִשְׂחָק שֶׁאֲנַחְנוּ מַכִּירִים." },
    { "id": "core.home.bubble", "text": "מַה בַּבַּקְבּוּק?" },
    { "id": "welcome.hello.1", "text": "שָׁלוֹם! אֵיזֶה כֵּיף לִרְאוֹת אֶתְכֶם." },
    { "id": "welcome.hello.2", "text": "שָׁלוֹם! כֵּיף שֶׁאֲנַחְנוּ בְּיַחַד." },
    { "id": "welcome.hello.3", "text": "שָׁלוֹם! יֵשׁ לִי רַעְיוֹן לְהַרְפַּתְקָה." },
    { "id": "welcome.hello.first", "text": "שָׁלוֹם! הַיּוֹם מַתְחִילָה הַהַרְפַּתְקָה שֶׁלָּנוּ." },
    { "id": "welcome.topic.counting.count", "text": "הַיּוֹם נִסְפֹּר יַחַד." },
    { "id": "welcome.topic.counting.glance", "text": "הַיּוֹם נִרְאֶה כַּמָּה יֵשׁ בְּמַבָּט אֶחָד." },
    { "id": "welcome.topic.counting.numerals", "text": "הַיּוֹם נַכִּיר אֶת הַמִּסְפָּרִים." },
    { "id": "welcome.topic.counting.compare", "text": "הַיּוֹם נְגַלֶּה אֵיפֹה יוֹתֵר וְאֵיפֹה פָּחוֹת." },
    { "id": "welcome.topic.counting.ordinal", "text": "הַיּוֹם נְגַלֶּה מִי רִאשׁוֹן וּמִי אַחֲרוֹן." },
    { "id": "welcome.topic.counting.big", "text": "הַיּוֹם נִסְפֹּר מִסְפָּרִים גְּדוֹלִים." },
    { "id": "welcome.topic.counting.order", "text": "הַיּוֹם נְטַיֵּל עַל צִיר הַמִּסְפָּרִים." },
    { "id": "welcome.topic.counting.parts", "text": "הַיּוֹם נְפָרֵק מִסְפָּרִים לַחֲלָקִים." },
    { "id": "welcome.topic.colors.match", "text": "הַיּוֹם נְמַיֵּן וְנַתְאִים לְפִי צֶבַע." },
    { "id": "welcome.topic.colors.names", "text": "הַיּוֹם נַכִּיר אֶת הַצְּבָעִים." },
    { "id": "welcome.topic.colors.mix", "text": "הַיּוֹם נְעַרְבֵּב צְבָעִים וּנְקַבֵּל צֶבַע חָדָשׁ." },
    { "id": "welcome.topic.colors.shades", "text": "הַיּוֹם נַכִּיר צֶבַע בָּהִיר וְצֶבַע כֵּהֶה." },
    { "id": "welcome.topic.colors.rainbow", "text": "הַיּוֹם נְסַדֵּר אֶת צִבְעֵי הַקֶּשֶׁת." },
    { "id": "welcome.topic.shapes.names", "text": "הַיּוֹם נַכִּיר צוּרוֹת." },
    { "id": "welcome.topic.shapes.world", "text": "הַיּוֹם נְחַפֵּשׂ צוּרוֹת בָּעוֹלָם." },
    { "id": "welcome.topic.shapes.build", "text": "הַיּוֹם נִבְנֶה תְּמוּנָה מִצּוּרוֹת." },
    { "id": "welcome.topic.shapes.solids", "text": "הַיּוֹם נַכִּיר כַּדּוּר, קֻבִּיָּה וְגָלִיל." },
    { "id": "welcome.topic.shapes.position", "text": "הַיּוֹם נְגַלֶּה אֵיפֹה כׇּל דָּבָר נִמְצָא." },
    { "id": "welcome.topic.shapes.lines", "text": "הַיּוֹם נַכִּיר קַו יָשָׁר וְקַו עָקֹם." },
    { "id": "welcome.topic.shapes.sides", "text": "הַיּוֹם נִבְדֹּק אֶת הַצְּלָעוֹת שֶׁל הַצּוּרוֹת." },
    { "id": "welcome.topic.logic.same", "text": "הַיּוֹם נְחַפֵּשׂ מַה דּוֹמֶה וּמַה שּׁוֹנֶה." },
    { "id": "welcome.topic.logic.sort", "text": "הַיּוֹם נְמַיֵּן לִשְׁתֵּי קְבוּצוֹת." },
    { "id": "welcome.topic.logic.patterns", "text": "הַיּוֹם נְגַלֶּה אֵיךְ הַסֵּדֶר מַמְשִׁיךְ." },
    { "id": "welcome.topic.logic.story", "text": "הַיּוֹם נְסַדֵּר סִפּוּר: מַה קֹּדֶם וּמַה בַּסּוֹף." },
    { "id": "welcome.topic.logic.size", "text": "הַיּוֹם נְסַדֵּר דְּבָרִים לְפִי הַגֹּדֶל." },
    { "id": "welcome.topic.logic.think", "text": "הַיּוֹם נַחְשֹׁב כְּמוֹ בַּלָּשִׁים." },
    { "id": "welcome.topic.robots.steps", "text": "הַיּוֹם נְסַדֵּר שְׁלָבִים: מַה קֹּדֶם וּמָה אַחַר כָּךְ." },
    { "id": "welcome.topic.robots.move", "text": "הַיּוֹם נַגִּיד לָרוֹבּוֹט לְאָן לָלֶכֶת." },
    { "id": "welcome.topic.robots.fix", "text": "הַיּוֹם נְתַקֵּן אֶת הַתׇּכְנִית שֶׁל הָרוֹבּוֹט." },
    { "id": "welcome.topic.market.addsub", "text": "הַיּוֹם נוֹסִיף וְנִקַּח, וְנִסְפֹּר כַּמָּה יֵשׁ." },
    { "id": "welcome.topic.market.share", "text": "הַיּוֹם נְחַלֵּק שָׁוֶה בְּשָׁוֶה." },
    { "id": "welcome.topic.market.missing", "text": "הַיּוֹם נְגַלֶּה מָה חָסֵר." },
    { "id": "welcome.topic.market.equal", "text": "הַיּוֹם נִבְדֹּק אִם שְׁנֵי הַצְּדָדִים שָׁוִים." },
    { "id": "welcome.topic.market.measure", "text": "הַיּוֹם נַשְׁוֶה גָּדוֹל וְקָטָן, אָרֹךְ וְקָצָר, כָּבֵד וְקַל." },
    { "id": "welcome.topic.market.graph", "text": "הַיּוֹם נִקְרָא תַּרְשִׁים שֶׁל תְּמוּנוֹת." },
    { "id": "welcome.topic.market.time", "text": "הַיּוֹם נִלְמַד עַל הַזְּמַן." },
    { "id": "welcome.topic.market.money", "text": "הַיּוֹם נְשַׂחֵק בַּחֲנוּת עִם מַטְבְּעוֹת." },
    { "id": "welcome.land.counting", "text": "הַיּוֹם נֵצֵא אֶל גִּבְעוֹת הַסְּפִירָה." },
    { "id": "welcome.land.colors", "text": "הַיּוֹם נֵצֵא אֶל מִפְרַץ הַצְּבָעִים." },
    { "id": "welcome.land.shapes", "text": "הַיּוֹם נֵצֵא אֶל יַעַר הַצּוּרוֹת." },
    { "id": "welcome.land.logic", "text": "הַיּוֹם נֵצֵא אֶל מְעָרַת הַחִידוֹת." },
    { "id": "welcome.land.robots", "text": "הַיּוֹם נֵצֵא אֶל נְמַל הָרוֹבּוֹטִים." },
    { "id": "welcome.land.market", "text": "הַיּוֹם נֵצֵא אֶל כְּפַר הַשּׁוּק." },
    { "id": "welcome.close", "text": "בּוֹאוּ נִפְתַּח אֶת הַבַּקְבּוּק." },
    { "id": "core.skill.col_a_01", "text": "מוֹצְאִים אֶת אוֹתוֹ צֶבַע" },
    { "id": "core.skill.col_a_02", "text": "מַצְבִּיעִים עַל אָדֹם, כָּחֹל, צָהֹב וְיָרֹק" },
    { "id": "core.skill.col_a_03", "text": "מַכִּירִים עוֹד צְבָעִים" },
    { "id": "core.skill.col_a_04", "text": "מְמַיְּנִים לְפִי צֶבַע" },
    { "id": "core.skill.col_a_05", "text": "יוֹדְעִים אֵיזֶה צֶבַע יֵשׁ לַדְּבָרִים" },
    { "id": "core.skill.col_a_06", "text": "מַכִּירִים חוּם וְאָפֹר" },
    { "id": "core.skill.col_a_07", "text": "מוֹצְאִים אֶת הַדָּבָר הַנָּכוֹן לְפִי הַצֶּבַע" },
    { "id": "core.skill.col_b_01", "text": "מְעָרְבְּבִים וּמְקַבְּלִים צֶבַע חָדָשׁ" },
    { "id": "core.skill.col_b_02", "text": "מְסַדְּרִים מִבָּהִיר לְכֵהֶה" },
    { "id": "core.skill.col_b_03", "text": "כָּחֹל בָּהִיר הוּא גַּם כָּחֹל" },
    { "id": "core.skill.col_b_04", "text": "מְמַיְּנִים לְפִי צֶבַע וּלְפִי צוּרָה" },
    { "id": "core.skill.col_b_06", "text": "מְסַדְּרִים אֶת הַקֶּשֶׁת" },
    { "id": "core.skill.cs_a_01", "text": "מְסַדְּרִים שְׁלָבִים: מַה קֹּדֶם, מַה בַּסּוֹף" },
    { "id": "core.skill.cs_a_03", "text": "מְזִיזִים רוֹבּוֹט בַּחִצִּים" },
    { "id": "core.skill.cs_a_04", "text": "מְתַכְנְנִים אֶת הַדֶּרֶךְ וְאָז יוֹצְאִים" },
    { "id": "core.skill.cs_a_05", "text": "מוֹצְאִים אֶת הַשָּׁלָב שֶׁלֹּא שַׁיָּךְ" },
    { "id": "core.skill.cs_b_01", "text": "מְתַכְנְנִים דֶּרֶךְ שֶׁל כַּמָּה צְעָדִים" },
    { "id": "core.skill.cs_b_04", "text": "מוֹצְאִים אֶת הַצַּעַד הַלֹּא נָכוֹן" },
    { "id": "core.skill.log_a_01", "text": "מוֹצְאִים אֶת הַדָּבָר הַזֵּהֶה" },
    { "id": "core.skill.log_a_02", "text": "מוֹצְאִים מִי שׁוֹנֶה" },
    { "id": "core.skill.log_a_03", "text": "מְמַיְּנִים לִשְׁתֵּי קְבוּצוֹת" },
    { "id": "core.skill.log_a_04", "text": "מַכִּירִים סֵדֶר שֶׁחוֹזֵר" },
    { "id": "core.skill.log_a_05", "text": "מַעֲתִיקִים אֶת הַסֵּדֶר" },
    { "id": "core.skill.log_a_06", "text": "מַמְשִׁיכִים אֶת הַסֵּדֶר" },
    { "id": "core.skill.log_a_07", "text": "מְתַקְּנִים סֵדֶר שֶׁנִּשְׁבַּר" },
    { "id": "core.skill.log_a_08", "text": "מְסַדְּרִים סִפּוּר: קֹדֶם, אַחַר כָּךְ, בַּסּוֹף" },
    { "id": "core.skill.log_a_09", "text": "מוֹצְאִים מָה הוֹלֵךְ יַחַד" },
    { "id": "core.skill.log_a_10", "text": "מְסַדְּרִים לְפִי גֹּדֶל" },
    { "id": "core.skill.log_b_01", "text": "מַמְשִׁיכִים סֵדֶר שֶׁל שְׁלוֹשָׁה דְּבָרִים" },
    { "id": "core.skill.log_b_02", "text": "מוֹצְאִים מַה נִּשְׁבַּר בַּסֵּדֶר" },
    { "id": "core.skill.log_b_04", "text": "מִגְדָּלִים שֶׁגְּדֵלִים" },
    { "id": "core.skill.log_b_06", "text": "מוֹצְאִים מַה מְשֻׁתָּף" },
    { "id": "core.skill.log_b_08", "text": "אִם… אָז…" },
    { "id": "core.skill.log_b_09", "text": "לֹא זֶה וְלֹא זֶה" },
    { "id": "core.skill.log_b_11", "text": "מְסַדְּרִים מִנָּמוּךְ לְגָבוֹהַּ" },
    { "id": "core.skill.math_a_01", "text": "מוֹסִיפִים עוֹד וְסוֹפְרִים כַּמָּה" },
    { "id": "core.skill.math_a_02", "text": "לוֹקְחִים אֶחָד וְסוֹפְרִים כַּמָּה נִשְׁאַר" },
    { "id": "core.skill.math_a_03", "text": "מְחַלְּקִים בַּהֲגִינוּת: לְכׇל אֶחָד אוֹתוֹ מִסְפָּר" },
    { "id": "core.skill.math_a_04", "text": "מַשְׁוִים גָּדוֹל וְקָטָן, אָרֹךְ וְקָצָר, כָּבֵד וְקַל" },
    { "id": "core.skill.math_a_05", "text": "מַכִּירִים בֹּקֶר, צָהֳרַיִם, עֶרֶב וְלַיְלָה" },
    { "id": "core.skill.math_a_06", "text": "קוֹנִים בַּחֲנוּת: מַטְבֵּעַ לְכׇל דָּבָר" },
    { "id": "core.skill.math_a_07", "text": "מַשְׁוִים בְּתַרְשִׁים תְּמוּנוֹת" },
    { "id": "core.skill.math_b_01", "text": "מוֹסִיפִים וְלוֹקְחִים" },
    { "id": "core.skill.math_b_02", "text": "מוֹצְאִים אֶת הַחֵלֶק שֶׁחָסֵר" },
    { "id": "core.skill.math_b_03", "text": "קוֹרְאִים תַּרְגִּילִים עִם פְּלוּס וּמִינוּס" },
    { "id": "core.skill.math_b_06", "text": "מַשְׁלִימִים לְעֶשֶׂר" },
    { "id": "core.skill.math_b_07", "text": "אֶפֶס לֹא מְשַׁנֶּה" },
    { "id": "core.skill.math_b_08", "text": "מְחַבְּרִים עַד עֶשְׂרִים" },
    { "id": "core.skill.math_b_09", "text": "שְׁנֵי הַצְּדָדִים אוֹתוֹ דָּבָר" },
    { "id": "core.skill.math_b_10", "text": "קְבוּצוֹת עִם אוֹתוֹ מִסְפָּר" },
    { "id": "core.skill.math_b_13", "text": "מִי כָּבֵד יוֹתֵר" },
    { "id": "core.skill.math_b_14", "text": "יוֹם רִאשׁוֹן, יוֹם שֵׁנִי…" },
    { "id": "core.skill.math_b_15", "text": "קוֹרְאִים שָׁעוֹת עֲגֻלּוֹת" },
    { "id": "core.skill.math_b_16", "text": "מַכִּירִים אֶת הַמַּטְבְּעוֹת" },
    { "id": "core.skill.math_b_17", "text": "מְשַׁלְּמִים בְּדִיּוּק" },
    { "id": "core.skill.math_b_18", "text": "מוֹצְאִים אֶת הַמִּסְפָּר הֶחָסֵר" },
    { "id": "core.skill.math_b_19", "text": "קוֹרְאִים תַּרְשִׁים שֶׁל תְּמוּנוֹת" },
    { "id": "core.skill.num_a_01", "text": "סוֹפְרִים עַד חָמֵשׁ, לְפִי הַסֵּדֶר" },
    { "id": "core.skill.num_a_02", "text": "סוֹפְרִים עַד עֶשֶׂר, לְפִי הַסֵּדֶר" },
    { "id": "core.skill.num_a_03", "text": "נוֹגְעִים בְּכׇל אֶחָד פַּעַם אַחַת כְּשֶׁסּוֹפְרִים" },
    { "id": "core.skill.num_a_04", "text": "יוֹדְעִים כַּמָּה יֵשׁ: הַמִּסְפָּר הָאַחֲרוֹן שֶׁסָּפַרְנוּ" },
    { "id": "core.skill.num_a_05", "text": "רוֹאִים כַּמָּה בְּמַבָּט אֶחָד" },
    { "id": "core.skill.num_a_06", "text": "נוֹתְנִים בְּדִיּוּק כַּמָּה שֶׁבִּקְשׁוּ" },
    { "id": "core.skill.num_a_07", "text": "מַתְאִימִים מִסְפָּר לַכַּמּוּת" },
    { "id": "core.skill.num_a_08", "text": "מוֹצְאִים אֶת הַמִּסְפָּר שֶׁאוֹמְרִים" },
    { "id": "core.skill.num_a_09", "text": "סוֹפְרִים עַד עֶשֶׂר" },
    { "id": "core.skill.num_a_10", "text": "רוֹאִים אַרְבַּע וְחָמֵשׁ בְּמַבָּט אֶחָד" },
    { "id": "core.skill.num_a_11", "text": "יוֹדְעִים אֵיפֹה יוֹתֵר וְאֵיפֹה פָּחוֹת" },
    { "id": "core.skill.num_a_12", "text": "סוֹפְרִים כְּדֵי לְהַשְׁווֹת, לֹא מִסְתַּכְּלִים עַל הַגֹּדֶל" },
    { "id": "core.skill.num_a_13", "text": "יוֹדְעִים מִי רִאשׁוֹן, שֵׁנִי, שְׁלִישִׁי וְאַחֲרוֹן" },
    { "id": "core.skill.num_a_14", "text": "יוֹדְעִים שֶׁאֵין כְּלוּם זֶה אֶפֶס" },
    { "id": "core.skill.num_b_01", "text": "סוֹפְרִים עַד עֶשְׂרִים" },
    { "id": "core.skill.num_b_02", "text": "סוֹפְרִים עַד שְׁלוֹשִׁים" },
    { "id": "core.skill.num_b_03", "text": "סוֹפְרִים אֲחוֹרָה כְּמוֹ בַּחֲלָלִית" },
    { "id": "core.skill.num_b_04", "text": "סוֹפְרִים עַד עֶשְׂרִים חֲפָצִים" },
    { "id": "core.skill.num_b_05", "text": "נוֹתְנִים בְּדִיּוּק כַּמָּה שֶׁמְּבַקְשִׁים" },
    { "id": "core.skill.num_b_07", "text": "כּוֹתְבִים אֶת הַמִּסְפָּרִים" },
    { "id": "core.skill.num_b_08", "text": "קוֹרְאִים אֶת הַמִּסְפָּרִים עַד עֶשְׂרִים" },
    { "id": "core.skill.num_b_10", "text": "מַשְׁוִים שְׁנֵי מִסְפָּרִים" },
    { "id": "core.skill.num_b_11", "text": "מוֹצְאִים מִסְפָּר שֶׁחָסֵר, אֶחָד יוֹתֵר וְאֶחָד פָּחוֹת" },
    { "id": "core.skill.num_b_13", "text": "קוֹפְצִים עַל צִיר הַמִּסְפָּרִים" },
    { "id": "core.skill.num_b_14", "text": "מְפָרְקִים מִסְפָּר לִשְׁנֵי חֲלָקִים" },
    { "id": "core.skill.num_b_16", "text": "רוֹאִים עֶשֶׂר וְעוֹד כַּמָּה" },
    { "id": "core.skill.num_b_17", "text": "סוֹפְרִים בַּעֲשָׂרוֹת וּבִשְׁתַּיִם" },
    { "id": "core.skill.num_b_18", "text": "מְחַלְּקִים לְזוּגוֹת" },
    { "id": "core.skill.shp_a_01", "text": "מוֹצְאִים אֶת אוֹתָהּ צוּרָה" },
    { "id": "core.skill.shp_a_02", "text": "מַכִּירִים עִגּוּל, רִבּוּעַ וּמְשֻׁלָּשׁ" },
    { "id": "core.skill.shp_a_03", "text": "מַכִּירִים צוּרוֹת גְּדוֹלוֹת, קְטַנּוֹת וּמְסֻבָּבוֹת" },
    { "id": "core.skill.shp_a_04", "text": "מַכִּירִים מַלְבֵּן" },
    { "id": "core.skill.shp_a_05", "text": "מוֹצְאִים צוּרוֹת בָּעוֹלָם" },
    { "id": "core.skill.shp_a_06", "text": "בּוֹנִים תְּמוּנָה מִצּוּרוֹת" },
    { "id": "core.skill.shp_a_07", "text": "יוֹדְעִים מַה מִּתְגַּלְגֵּל וּמָה נֶעֱרָם" },
    { "id": "core.skill.shp_a_08", "text": "מְבִינִים עַל, מִתַּחַת, בְּתוֹךְ וּלְיַד" },
    { "id": "core.skill.shp_a_10", "text": "מַכִּירִים קַו יָשָׁר וְקַו עָקֹם" },
    { "id": "core.skill.shp_b_01", "text": "מַכִּירִים מְשֻׁלָּשׁ, מְרֻבָּע, מְחֻמָּשׁ וּמְשֻׁשֶּׁה" },
    { "id": "core.skill.shp_b_02", "text": "סוֹפְרִים צְלָעוֹת" },
    { "id": "core.skill.shp_b_03", "text": "רִבּוּעַ וּמַלְבֵּן" },
    { "id": "core.skill.shp_b_04", "text": "צוּרָה סְגוּרָה עִם צְלָעוֹת יְשָׁרוֹת" },
    { "id": "core.skill.shp_b_08", "text": "גָּלִיל, חָרוּט, כַּדּוּר וּפִירָמִידָה" },
    { "id": "core.skill.shp_b_09", "text": "כׇּל גּוּף וְהַצּוּרָה שֶׁעָלָיו" }
  ]
}
