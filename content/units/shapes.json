  "tagFeedback": {
    "M-SHP-ORIENT": "צוּרָה נִשְׁאֶרֶת אוֹתָהּ צוּרָה גַּם כְּשֶׁמְּסֹבְבִים אוֹתָהּ. בּוֹאוּ נִבְדֹּק.",
    "M-SHP-PROTO": "אוֹתָהּ צוּרָה יְכוֹלָה לְהֵרָאוֹת קְצָת אַחֶרֶת. בּוֹאוּ נִסְפֹּר צְלָעוֹת.",
    "M-SHP-SIZE": "צוּרָה גְּדוֹלָה וְצוּרָה קְטַנָּה יְכוֹלוֹת לִהְיוֹת אוֹתָהּ צוּרָה. בּוֹאוּ נִבְדֹּק.",
    "M-SHP-SQRECT": "בְּרִבּוּעַ כׇּל הַצְּלָעוֹת שָׁווֹת. בְּמַלְבֵּן יֵשׁ צְלָעוֹת אֲרֻכּוֹת וּקְצָרוֹת.",
    "M-SPACE-WORD": "הַמִּלָּה אוֹמֶרֶת אֵיפֹה הַכַּדּוּר. בּוֹאוּ נִסְתַּכֵּל שׁוּב."
  },
  "misconceptions": [
    { "id": "M-SHP-ORIENT", "skills": ["SHP-A-03"], "parent": "הילד לא מכיר ריבוע מסובב או משולש הפוך כאותה צורה.", "home": "לגזור ריבוע מנייר ולסובב אותו על השולחן, ולשאול בכל פעם: מה זה? להראות שהצורה נשארת אותה צורה.", "reps": ["concrete", "embodied"] },
    { "id": "M-SHP-PROTO", "skills": ["SHP-A-03"], "parent": "הילד מזהה רק את הצורה הרגילה, למשל משולש שווה צלעות, ולא משולש צר וגבוה.", "home": "לצייר יחד כמה משולשים שונים, רחבים וצרים, ולספור בכל אחד שלוש צלעות.", "reps": ["pictorial", "concrete"] },
    { "id": "M-SHP-SIZE", "skills": ["SHP-A-03"], "parent": "הילד חושב שצורה גדולה וצורה קטנה הן צורות שונות.", "home": "להניח עיגול גדול ועיגול קטן זה ליד זה, ולשאול: מה אותו דבר? לעזור לו להגיד 'שניהם עיגולים'.", "reps": ["concrete"] },
    { "id": "M-SHP-SQRECT", "skills": ["SHP-A-04"], "parent": "הילד מבלבל בין ריבוע למלבן.", "home": "למדוד בנייר שני צדדים של ריבוע ושל מלבן, ולהשוות: במה הם שונים?", "reps": ["concrete", "pictorial"] },
    { "id": "M-SPACE-WORD", "skills": ["SHP-A-08"], "parent": "הילד מבלבל בין מילות מקום כמו על ומתחת.", "home": "להניח כדור על שולחן ומתחתיו, ולהגיד את המילה בכל פעם ('על השולחן', 'מתחת לשולחן'). אחר כך לבקש מהילד להניח לפי המילה.", "reps": ["concrete", "embodied"] }
  ],
