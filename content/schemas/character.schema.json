{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nitznutz:schema:character",
  "title": "Nitznutz character",
  "type": "object",
  "properties": {
    "schema": {
      "const": "character-lite/v1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 41,
      "pattern": "^(?:[a-z0-9][a-z0-9-]{2,40})$"
    },
    "review": {
      "type": "string",
      "enum": [
        "needs-editor",
        "approved"
      ]
    },
    "name": {
      "type": "object",
      "properties": {
        "he": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "gender": {
          "type": "string",
          "enum": [
            "m",
            "f"
          ]
        }
      },
      "required": [
        "he",
        "gender"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "guide_tutor",
          "map_companion",
          "celebration_cameo",
          "activity_helper",
          "sticker"
        ]
      },
      "minItems": 1,
      "maxItems": 5
    },
    "images": {
      "type": "object",
      "properties": {
        "idle": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "talk_closed": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "talk_open": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "celebrate": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "think": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "listen": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "encourage": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "surprised": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "sleepy": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "blink": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        },
        "wave": {
          "type": "string",
          "minLength": 7,
          "maxLength": 46,
          "pattern": "^(?:asset:[a-z0-9_]{1,40})$"
        }
      },
      "required": [
        "idle",
        "talk_closed",
        "talk_open",
        "celebrate",
        "think",
        "listen",
        "encourage"
      ],
      "additionalProperties": false
    },
    "mouth": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "distribution": {
      "type": "string",
      "enum": [
        "bundled",
        "personal"
      ]
    },
    "personalUseOnly": {
      "type": "boolean"
    },
    "palette": {
      "type": "object",
      "properties": {
        "dominant": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^(?:#[0-9A-Fa-f]{6})$"
        }
      },
      "required": [
        "dominant"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "roles",
    "images",
    "mouth",
    "canvas",
    "distribution",
    "personalUseOnly",
    "palette"
  ],
  "additionalProperties": false
}
